# BookForge configuration. Copy to .env and fill in.
# Every setting maps to a BOOKFORGE_<NAME> environment variable.

# --- LLM provider -----------------------------------------------------------
# Model names are LiteLLM identifiers: "<provider>/<model>".
# The openai/ prefix plus an api_base addresses any OpenAI-compatible gateway
# (NVIDIA NIM, vLLM, Ollama, Together, ...).

BOOKFORGE_OPENAI_API_KEY=
BOOKFORGE_OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

BOOKFORGE_ANALYST_MODEL=openai/nvidia/nemotron-3-ultra-550b-a55b
BOOKFORGE_WRITER_MODEL=openai/nvidia/nemotron-3-ultra-550b-a55b
BOOKFORGE_CRITIC_MODEL=openai/nvidia/nemotron-3-ultra-550b-a55b
BOOKFORGE_CAPTION_MODEL=openai/nvidia/nemotron-3-ultra-550b-a55b
# GEPA reflects on failures with this model; a strong one pays off here.
BOOKFORGE_REFLECTION_MODEL=openai/nvidia/nemotron-3-ultra-550b-a55b

# Alternatives — set the matching provider key instead of the two above.
#   GOOGLE_API_KEY=...        BOOKFORGE_ANALYST_MODEL=gemini/gemini-2.5-pro
#   ANTHROPIC_API_KEY=...     BOOKFORGE_ANALYST_MODEL=anthropic/claude-sonnet-4-5
#   OPENAI_API_KEY=...        BOOKFORGE_ANALYST_MODEL=openai/gpt-4o
#   (leave BOOKFORGE_OPENAI_API_BASE empty for real OpenAI)

# --- Sampling ---------------------------------------------------------------
# Extraction runs cold for reproducibility; prose runs warmer; the judge runs
# at zero, because a judge that changes its mind is not a judge.
BOOKFORGE_ANALYST_TEMPERATURE=0.2
BOOKFORGE_WRITER_TEMPERATURE=0.4
BOOKFORGE_CRITIC_TEMPERATURE=0.0
BOOKFORGE_MAX_TOKENS=16384
BOOKFORGE_LM_CACHE=true

# --- Book design ------------------------------------------------------------
# textbook = generous margins, margin notes, coloured callouts (default)
# academic = tighter, monochrome, closer to a journal book
# compact  = smaller trim, denser type, for reference material
BOOKFORGE_BOOK_THEME=textbook
BOOKFORGE_BOOK_SUBTITLE=
BOOKFORGE_BOOK_AUTHOR=Compiled by BookForge

# --- Scope ------------------------------------------------------------------
# BOOKFORGE_MAX_VIDEOS=3
BOOKFORGE_MIN_VIDEO_DURATION_SEC=30
BOOKFORGE_MAX_VIDEO_DURATION_SEC=10800

# --- Local input ------------------------------------------------------------
# `bookforge build ./talks` scans a folder; these decide what it picks up and
# in what order. A transcript sitting beside a video of the same name is used
# as that video's transcript rather than becoming a chapter of its own.
# BOOKFORGE_VIDEO_EXTENSIONS=.mp4,.mkv,.mov,.webm,.avi,.m4v,.mpg,.mpeg,.wmv
# BOOKFORGE_TRANSCRIPT_EXTENSIONS=.srt,.vtt,.txt,.md
BOOKFORGE_LOCAL_ORDER=name           # name | modified | created

# --- YouTube access ---------------------------------------------------------
# YouTube refuses media and caption downloads from datacentre IPs with
# "Sign in to confirm you're not a bot". Channel *listing* still works, which
# makes this a confusing failure: intake succeeds and every download fails.
# Export cookies.txt (Netscape format) from a signed-in browser and point here.
# BOOKFORGE_YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
# On a desktop, read them straight from the browser profile instead:
# BOOKFORGE_YOUTUBE_COOKIES_FROM_BROWSER=chrome
# BOOKFORGE_YOUTUBE_PROXY=

# --- Transcript handling ----------------------------------------------------
# Long transcripts are windowed, never truncated. Hitting the chunk budget
# widens the windows rather than dropping the end of the talk.
BOOKFORGE_TRANSCRIPT_CHUNK_CHARS=24000
BOOKFORGE_TRANSCRIPT_CHUNK_OVERLAP_CHARS=1200
BOOKFORGE_MAX_TRANSCRIPT_CHUNKS=12

# --- Media ------------------------------------------------------------------
BOOKFORGE_FRAME_INTERVAL_SEC=5
BOOKFORGE_FRAME_PHASH_THRESHOLD=6
BOOKFORGE_MAX_FRAMES_PER_CHAPTER=12
BOOKFORGE_DOWNLOAD_RESOLUTION=480
BOOKFORGE_WHISPER_MODEL=base

# --- Quality ----------------------------------------------------------------
BOOKFORGE_QA_MAX_ITERATIONS=3
BOOKFORGE_QA_ACCEPT_SCORE=0.92          # accept and stop refining
BOOKFORGE_QA_MIN_ACCEPTABLE_SCORE=0.55  # below this the chapter is failed, not shipped
BOOKFORGE_MIN_GROUNDING_SCORE=0.6       # resample the analysis below this
BOOKFORGE_COMPILE_LATEX=true            # false = draft mode, no compile verification
BOOKFORGE_LATEX_TIMEOUT_SEC=180

# --- Concurrency ------------------------------------------------------------
BOOKFORGE_MEDIA_PREFETCH_CONCURRENCY=3
BOOKFORGE_NUM_THREADS=4

# --- Optimization -----------------------------------------------------------
BOOKFORGE_OPTIMIZER=gepa                # gepa | miprov2 | simba | bootstrap
BOOKFORGE_OPTIMIZER_BUDGET=light        # light | medium | heavy
BOOKFORGE_ARTIFACTS_DIR=artifacts
BOOKFORGE_LOAD_OPTIMIZED=true

# --- Observability ----------------------------------------------------------
BOOKFORGE_ENABLE_MLFLOW=false
BOOKFORGE_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
BOOKFORGE_MLFLOW_EXPERIMENT=bookforge-dspy

# --- Web UI -----------------------------------------------------------------
# `bookforge serve` binds to localhost by default. There is no authentication:
# the server can read and write anywhere under the workspace root, so bind it
# to 0.0.0.0 only behind a reverse proxy that authenticates.
BOOKFORGE_UPLOAD_MAX_MB=2048

# --- Housekeeping -----------------------------------------------------------
BOOKFORGE_WORKSPACE_ROOT=data
BOOKFORGE_LOG_LEVEL=INFO
BOOKFORGE_LOG_JSON=false
